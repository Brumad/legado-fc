{
  "extends": "./tsconfig.json",
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "db",
    "worker",
    "build",
    "dist",
    "github-dist",
    ".next",
    ".vinext"
  ],
  "compilerOptions": {
    "allowImportingTsExtensions": true
  }
}
